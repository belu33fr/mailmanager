{% import "components/form/fields_macros.html.twig" as fields %}
{% import '@mailmanager/mailserver.macros.html.twig' as mm %}
{# Données JS pour le contact technique #}
<script>
window.mailmanagerServer = {
    defaultPorts: {{ default_ports|raw }},
    passwordInOutTypes: {{ password_in_out_types|json_encode|raw }},
    ajaxUrl: '{{ ajax_url }}'
};
</script>
{{ mm.section(__('Comptes d\'accès', 'mailmanager')) }}
{% if accounts_class %}
    {{ fields.dropdownField(
        accounts_class,
        'plugin_accounts_accounts_id',
        item.fields['plugin_accounts_accounts_id'] ?? 0,
        __('Compte administrateur (accès serveur)', 'mailmanager'),
        {'display_emptychoice': true}
    ) }}
{% else %}
    <div class="alert alert-warning col-12">
        <i class="ti ti-alert-triangle me-2"></i>
        {{ __('Plugin Accounts requis pour la gestion des mots de passe.', 'mailmanager') }}
    </div>
{% endif %}

{# Contact technique (obligatoire) : déduit du compte d'accès, modifiable à la main #}
{{ fields.dropdownField('User', 'users_id_tech', item.fields['users_id_tech'] ?? 0, __('Contact technique', 'mailmanager') ~ ' *', {
    'display_emptychoice': true,
    'right': 'all',
    'with_no_right': 1,
    'required': true,
    'helper': __('Personne à contacter pour ce serveur (obligatoire). Proposé automatiquement à partir du compte administrateur choisi ci-dessus (utilisateur ou technicien qui y est rattaché) ; vous pouvez choisir un autre utilisateur.', 'mailmanager')
}) }}
<div id="mm-tech-hint" class="col-12 mb-2" style="display:none"><small class="text-muted ms-3"></small></div>
