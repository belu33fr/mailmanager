{% import "components/form/fields_macros.html.twig" as fields %}
{% if canedit %}
<form method="post" action="{{ form_url }}">
    <input type="hidden" name="id" value="{{ item.fields['id'] }}" />
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />
{% endif %}
<div class="card-body">
<div class="row flex-row">
{% include '@mailmanager/mailserver.part_server.html.twig' %}

{% set fixed_net = item.fields['server_type'] in ['exchange', 'ms365'] %}
<div id="mm-params" class="col-12" data-type="{{ item.fields['server_type'] }}" data-ports='{{ default_ports|raw }}' data-pwtypes='{{ password_in_out_types|json_encode|raw }}'>
    <div id="mm-network-none" class="text-muted mb-2 ms-3" style="{{ fixed_net ? '' : 'display:none' }}">
        <i class="ti ti-info-circle me-1"></i>{{ __('Exchange et MS365 : le chiffrement et le port sont imposés par le service, rien à paramétrer.', 'mailmanager') }}
    </div>
    <div id="mm-network-fields" style="{{ fixed_net ? 'display:none' : '' }}">
        <div class="row flex-row">
            {% set enc_select %}
            <select name="encryption" id="mm-encryption" class="form-select">
                {% for enc, label in encryptions %}
                    <option value="{{ enc }}" {% if item.fields['encryption'] == enc %}selected{% endif %}>{{ label }}</option>
                {% endfor %}
            </select>
            {% endset %}
            {{ fields.field('encryption', enc_select, __('Chiffrement', 'mailmanager')) }}

            {{ fields.numberField('port', item.fields['port'] ?? 0, __('Port', 'mailmanager'), {
                'min': 1, 'max': 65535,
                'id': 'mm-port',
                'helper': __('Laissez 0 pour utiliser le port par défaut du type/chiffrement', 'mailmanager')
            }) }}
        </div>
    </div>
</div>

{{ fields.checkboxField('password_in_out', item.fields['password_in_out'] ?? 0, __('Mot de passe identique entrée/sortie', 'mailmanager'), {
    'container_id': 'mm-password-in-out-section',
    'helper': __('Le même compte sert pour la réception et l\'envoi', 'mailmanager')
}) }}

{% include '@mailmanager/mailserver.part_accounts.html.twig' %}
</div>
</div>
{% if canedit %}
    <div class="card-footer d-flex justify-content-end">
        <button type="submit" name="update" class="btn btn-primary">
            <i class="ti ti-device-floppy me-1"></i>{{ __('Sauvegarder') }}
        </button>
    </div>
</form>
{% endif %}
