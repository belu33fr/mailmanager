{% import "components/form/fields_macros.html.twig" as fields %}
{% if canedit %}
<form method="post" action="{{ form_url }}">
    <input type="hidden" name="id" value="{{ item.fields['id'] }}" />
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />
{% endif %}
<div class="card-body">
{# Domaines gérés : liste déroulante avec recherche, puis boutons Ajouter / Retirer #}
<div class="mb-3 row" id="mm-domains">
    <label class="col-xxl-4 col-form-label">{{ __('Domaines gérés', 'mailmanager') }}</label>
    <div class="col-xxl-8">
        <input type="hidden" name="_linked_domains_defined" value="1" />

        <div class="mb-2">
            <select id="mm-dom-available" class="form-select" data-placeholder="{{ __('Rechercher un domaine…', 'mailmanager') }}">
                <option value=""></option>
                {% for domain in all_domains %}
                    {% if domain.id not in linked_domains %}
                        <option value="{{ domain.id }}">{{ domain.name }}</option>
                    {% endif %}
                {% endfor %}
            </select>
        </div>

        <div class="d-flex align-items-center gap-2 mb-2">
            <button type="button" id="mm-dom-add" class="btn btn-primary">
                <i class="ti ti-plus me-1"></i>{{ __('Ajouter', 'mailmanager') }}
            </button>
            <button type="button" id="mm-dom-remove" class="btn btn-primary">
                <i class="ti ti-minus me-1"></i>{{ __('Retirer', 'mailmanager') }}
            </button>
            <button type="button" id="mm-dom-clear" class="btn btn-primary">
                <i class="ti ti-trash me-1"></i>{{ __('Efface liste', 'mailmanager') }}
            </button>
            <small class="text-muted ms-auto" id="mm-dom-count"></small>
        </div>

        <select id="mm-dom-selected" name="linked_domains_ids[]" class="form-select" multiple size="6" style="min-height:130px">
            {% for domain in all_domains %}
                {% if domain.id in linked_domains %}
                    <option value="{{ domain.id }}" selected>{{ domain.name }}</option>
                {% endif %}
            {% endfor %}
        </select>
        <small class="text-muted">{{ __('Choisissez un domaine dans la liste puis « Ajouter ». Double-clic ou « Retirer » pour enlever la sélection, « Efface liste » pour tout vider.', 'mailmanager') }}</small>
    </div>
</div>

{# État #}
{{ fields.dropdownField('State', 'states_id', item.fields['states_id'] ?? 0, __('État'), {
    'display_emptychoice': true
}) }}

{# Groupe #}
{{ fields.dropdownField('Group', 'groups_id', item.fields['groups_id'] ?? 0, __('Groupe propriétaire', 'mailmanager'), {
    'display_emptychoice': true,
    'only_my_groups': false,
    'helper': __('Groupe auquel appartient ce serveur (service ou entité responsable).', 'mailmanager')
}) }}

{# Groupe technique #}
{{ fields.dropdownField('Group', 'groups_id_tech', item.fields['groups_id_tech'] ?? 0, __('Groupe technique', 'mailmanager'), {
    'display_emptychoice': true,
    'only_my_groups': false,
    'helper': __('Groupe chargé de l\'administration et du suivi technique de ce serveur.', 'mailmanager')
}) }}
</div>
{% if canedit %}
    <div class="card-footer d-flex justify-content-end">
        <button type="submit" name="update" class="btn btn-primary">
            <i class="ti ti-device-floppy me-1"></i>{{ __('Sauvegarder') }}
        </button>
    </div>
</form>
{% endif %}
