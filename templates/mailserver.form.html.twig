{% extends "generic_show_form.html.twig" %}
{% import "components/form/fields_macros.html.twig" as fields %}

{% block more_fields %}

{# Données JS pour l'auto-complétion des ports #}
<script>
window.mailmanagerServer = {
    defaultPorts: {{ default_ports|raw }},
    passwordInOutTypes: {{ password_in_out_types|json_encode|raw }},
    ajaxUrl: '{{ ajax_url }}'
};
</script>

{{ fields.smallTitle(__('Informations générales', 'mailmanager')) }}

{# Type de serveur #}
<div class="mb-3 row">
    <label class="col-xxl-4 col-form-label">{{ __('Type de serveur', 'mailmanager') }} *</label>
    <div class="col-xxl-8">
        <select name="server_type" id="mm-server-type" class="form-select" required>
            {% for type, label in server_types %}
                <option value="{{ type }}" {% if item.fields['server_type'] == type %}selected{% endif %}>
                    {{ label }}
                </option>
            {% endfor %}
        </select>
    </div>
</div>

{# FQDN #}
{{ fields.textField('fqdn', item.fields['fqdn'] ?? '', __('FQDN / Hôte', 'mailmanager'), {
    'required': true,
    'helper': __('Ex: mail.example.com, smtp.office365.com', 'mailmanager')
}) }}

{# Chiffrement #}
<div class="mb-3 row">
    <label class="col-xxl-4 col-form-label">{{ __('Chiffrement', 'mailmanager') }}</label>
    <div class="col-xxl-8">
        <select name="encryption" id="mm-encryption" class="form-select">
            {% for enc, label in encryptions %}
                <option value="{{ enc }}" {% if item.fields['encryption'] == enc %}selected{% endif %}>
                    {{ label }}
                </option>
            {% endfor %}
        </select>
    </div>
</div>

{# Port #}
{{ fields.numberField('port', item.fields['port'] ?? 0, __('Port', 'mailmanager'), {
    'min': 1, 'max': 65535,
    'id': 'mm-port',
    'helper': __('Laissez 0 pour utiliser le port par défaut du type/chiffrement', 'mailmanager')
}) }}

{# Actif #}
{{ fields.checkboxField('is_active', item.fields['is_active'] ?? 1, __('Actif', 'mailmanager')) }}

{{ fields.smallTitle(__('Compte technique d\'accès', 'mailmanager')) }}

{% if accounts_class %}
    {{ fields.dropdownField(
        accounts_class,
        'plugin_accounts_accounts_id',
        item.fields['plugin_accounts_accounts_id'] ?? 0,
        __('Compte administrateur (accès serveur)', 'mailmanager'),
        {'display_emptychoice': true}
    ) }}
{% else %}
    <div class="alert alert-warning">
        <i class="ti ti-alert-triangle me-2"></i>
        {{ __('Plugin Accounts requis pour la gestion des mots de passe.', 'mailmanager') }}
    </div>
{% endif %}

{# Password In = Out (pertinent pour SMTP) #}
<div id="mm-password-in-out-section" class="mb-3 row" style="display:none">
    <label class="col-xxl-4 col-form-label">{{ __('Mot de passe identique entrée/sortie', 'mailmanager') }}</label>
    <div class="col-xxl-8 d-flex align-items-center">
        <input type="checkbox" name="password_in_out" id="mm-password-in-out" class="form-check-input"
               value="1" {% if item.fields['password_in_out'] ?? 0 %}checked{% endif %} />
        <small class="text-muted ms-2">{{ __('Le même compte sert pour la réception et l\'envoi', 'mailmanager') }}</small>
    </div>
</div>

{# Contact technique (obligatoire) : déduit du compte d'accès, modifiable à la main #}
{{ fields.dropdownField('User', 'users_id_tech', item.fields['users_id_tech'] ?? 0, __('Contact technique', 'mailmanager') ~ ' *', {
    'display_emptychoice': true,
    'right': 'all',
    'with_no_right': 1,
    'required': true,
    'helper': __('Personne à contacter pour ce serveur (obligatoire). Proposé automatiquement à partir du compte d\'accès ci-dessus ; vous pouvez choisir un autre utilisateur.', 'mailmanager')
}) }}
<div id="mm-tech-hint" class="mb-3 row" style="display:none">
    <div class="col-xxl-8 offset-xxl-4"><small class="text-muted"></small></div>
</div>

{{ fields.smallTitle(__('Organisation', 'mailmanager')) }}

{# Domaines gérés : liste déroulante avec recherche, puis boutons Ajouter / Retirer #}
<div class="mb-3 row" id="mm-domains">
    <label class="col-xxl-4 col-form-label">{{ __('Domaines gérés', 'mailmanager') }}</label>
    <div class="col-xxl-8">
        <input type="hidden" name="_linked_domains_defined" value="1" />

        <div class="mb-2">
            <select id="mm-dom-available" class="form-select" data-placeholder="{{ __('Rechercher un domaine…', 'mailmanager') }}">
                <option value=""></option>
                {% for domain in all_domains %}
                    {% if domain.id not in linked_domains %}
                        <option value="{{ domain.id }}">{{ domain.name }}</option>
                    {% endif %}
                {% endfor %}
            </select>
        </div>

        <div class="d-flex align-items-center gap-2 mb-2">
            <button type="button" id="mm-dom-add" class="btn btn-primary">
                <i class="ti ti-plus me-1"></i>{{ __('Ajouter', 'mailmanager') }}
            </button>
            <button type="button" id="mm-dom-remove" class="btn btn-primary">
                <i class="ti ti-minus me-1"></i>{{ __('Retirer', 'mailmanager') }}
            </button>
            <button type="button" id="mm-dom-clear" class="btn btn-primary">
                <i class="ti ti-trash me-1"></i>{{ __('Efface liste', 'mailmanager') }}
            </button>
            <small class="text-muted ms-auto" id="mm-dom-count"></small>
        </div>

        <select id="mm-dom-selected" name="linked_domains_ids[]" class="form-select" multiple size="6" style="min-height:130px">
            {% for domain in all_domains %}
                {% if domain.id in linked_domains %}
                    <option value="{{ domain.id }}" selected>{{ domain.name }}</option>
                {% endif %}
            {% endfor %}
        </select>
        <small class="text-muted">{{ __('Choisissez un domaine dans la liste puis « Ajouter ». Double-clic ou « Retirer » pour enlever la sélection, « Efface liste » pour tout vider.', 'mailmanager') }}</small>
    </div>
</div>

{# État #}
{{ fields.dropdownField('State', 'states_id', item.fields['states_id'] ?? 0, __('État'), {
    'display_emptychoice': true
}) }}

{# Groupe #}
{{ fields.dropdownField('Group', 'groups_id', item.fields['groups_id'] ?? 0, __('Groupe propriétaire', 'mailmanager'), {
    'display_emptychoice': true,
    'only_my_groups': false,
    'helper': __('Groupe auquel appartient ce serveur (service ou entité responsable).', 'mailmanager')
}) }}

{# Groupe technique #}
{{ fields.dropdownField('Group', 'groups_id_tech', item.fields['groups_id_tech'] ?? 0, __('Groupe technique', 'mailmanager'), {
    'display_emptychoice': true,
    'only_my_groups': false,
    'helper': __('Groupe chargé de l\'administration et du suivi technique de ce serveur.', 'mailmanager')
}) }}

{{ fields.smallTitle(__('Notes', 'mailmanager')) }}
{{ fields.textareaField('comment', item.fields['comment'] ?? '', __('Commentaire')) }}


{% endblock more_fields %}
