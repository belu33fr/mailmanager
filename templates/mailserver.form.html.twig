{% extends "generic_show_form.html.twig" %}
{% import "components/form/fields_macros.html.twig" as fields %}

{% block more_fields %}

{# Données JS pour l'auto-complétion des ports #}
<script>
window.mailmanagerServer = {
    defaultPorts: {{ default_ports|raw }},
    passwordInOutTypes: {{ password_in_out_types|json_encode|raw }},
    ajaxUrl: '{{ ajax_url }}'
};
</script>

{{ fields.smallTitle(__('Serveur', 'mailmanager')) }}
{# Type de serveur #}
<div class="mb-3 row">
    <label class="col-xxl-4 col-form-label">{{ __('Type de serveur', 'mailmanager') }} *</label>
    <div class="col-xxl-8">
        <select name="server_type" id="mm-server-type" class="form-select" required>
            {% for type, label in server_types %}
                <option value="{{ type }}" {% if item.fields['server_type'] == type %}selected{% endif %}>
                    {{ label }}
                </option>
            {% endfor %}
        </select>
    </div>
</div>

{# FQDN #}
{{ fields.textField('fqdn', item.fields['fqdn'] ?? '', __('FQDN / Hôte', 'mailmanager'), {
    'required': true,
    'helper': __('Ex: mail.example.com, smtp.office365.com', 'mailmanager')
}) }}


{{ fields.smallTitle(__('Comptes d\'accès', 'mailmanager')) }}
{% if accounts_class %}
    {{ fields.dropdownField(
        accounts_class,
        'plugin_accounts_accounts_id',
        item.fields['plugin_accounts_accounts_id'] ?? 0,
        __('Compte administrateur (accès serveur)', 'mailmanager'),
        {'display_emptychoice': true}
    ) }}
{% else %}
    <div class="alert alert-warning">
        <i class="ti ti-alert-triangle me-2"></i>
        {{ __('Plugin Accounts requis pour la gestion des mots de passe.', 'mailmanager') }}
    </div>
{% endif %}

{# Contact technique (obligatoire) : déduit du compte d'accès, modifiable à la main #}
{{ fields.dropdownField('User', 'users_id_tech', item.fields['users_id_tech'] ?? 0, __('Contact technique', 'mailmanager') ~ ' *', {
    'display_emptychoice': true,
    'right': 'all',
    'with_no_right': 1,
    'required': true,
    'helper': __('Personne à contacter pour ce serveur (obligatoire). Proposé automatiquement à partir du compte administrateur choisi ci-dessus (utilisateur ou technicien qui y est rattaché) ; vous pouvez choisir un autre utilisateur.', 'mailmanager')
}) }}
<div id="mm-tech-hint" class="mb-3 row" style="display:none">
    <div class="col-xxl-8 offset-xxl-4"><small class="text-muted"></small></div>
</div>


{% endblock more_fields %}
