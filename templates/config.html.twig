{% if canedit %}
<form method="post" action="{{ config_url }}">
{% endif %}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="ti ti-settings me-2"></i>
            {{ __('Configuration Mail Manager', 'mailmanager') }}
        </h3>
    </div>
    <div class="card-body">

        <div class="mb-3 row">
            <label class="col-xxl-4 col-form-label">{{ __('Type de serveur par défaut', 'mailmanager') }}</label>
            <div class="col-xxl-8">
                <select name="default_server_type" class="form-select" {% if not canedit %}disabled{% endif %}>
                    {% for type, label in {'pop3':'POP3','imap':'IMAP','smtp':'SMTP','exchange':'Exchange','ms365':'MS365'} %}
                        <option value="{{ type }}" {% if default_server_type == type %}selected{% endif %}>{{ label }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>

        <div class="mb-3 row">
            <label class="col-xxl-4 col-form-label">{{ __('Type de compte (plugin Accounts)', 'mailmanager') }}</label>
            <div class="col-xxl-8">
                <input type="text" name="accounts_plugin_type" class="form-control"
                       value="{{ accounts_plugin_type }}" {% if not canedit %}readonly{% endif %} />
            </div>
        </div>

    </div>
</div>

{% if canedit %}
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />
    <div class="mt-3 ms-3">
        <button type="submit" name="update" class="btn btn-primary">
            <i class="ti ti-device-floppy me-1"></i>{{ __('Enregistrer') }}
        </button>
    </div>
</form>
{% endif %}
